DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lexpatent?schema=public"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_REFRESH_SECRET="change-this-refresh-secret-in-production"
PORT=4000
NODE_ENV=development
# Comma-separated list is allowed (production domain + Vercel previews)
FRONTEND_URL="http://localhost:5173"
UPLOAD_DIR="./uploads"
SIMULATED_DATE="2026-08-18"

# --- Email alerts (SMTP) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LexPatent Docket Radar <docket@yourfirm.com>"

# --- WhatsApp alerts (Visity: https://wa.visity.io) ---
# Field names are configurable so a gateway change is an env edit, not a code change.
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
WHATSAPP_SENDER=""
WHATSAPP_AUTH_HEADER="Authorization"
WHATSAPP_AUTH_SCHEME="Bearer"
WHATSAPP_TO_FIELD="to"
WHATSAPP_MESSAGE_FIELD="message"
WHATSAPP_SENDER_FIELD="from"
